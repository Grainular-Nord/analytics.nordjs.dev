# Postgres connection
DATABASE_URL="postgresql://analytics:analytics@localhost:5433/analytics"

# Secret used to sign JWT session cookies (generate with: openssl rand -hex 32)
JWT_SECRET="replace-with-openssl-rand-hex-32-output"

# Origins allowed to call the dashboard API (comma separated)
CLIENT_ORIGINS="http://localhost:5173"

# Base URL of the SPA — used to build magic links logged to the console
CLIENT_URL="http://localhost:5173"

# WebAuthn relying party. For production: rpId=analytics.nordjs.dev
RP_ID="localhost"
RP_NAME="nordjs analytics"

# Raw events older than this are compacted into daily rollups
RETENTION_DAYS="90"

PORT="3000"
