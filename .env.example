# Production runtime environment template — installed on the server as
# RUNTIME_ENV_PATH (see README), not used for local development. Local dev
# uses apps/server/.env and apps/client/.env; `bun run db:up` uses
# docker-compose.dev.yml and needs no env file at all.

# Generate both with: openssl rand -hex 32
POSTGRES_PASSWORD="replace-with-a-long-random-password"
JWT_SECRET="replace-with-a-long-random-secret"

# Public URLs used by the API and WebAuthn.
CLIENT_URL="https://analytics.example.com"
CLIENT_ORIGINS="https://analytics.example.com"
RP_ID="analytics.example.com"
RP_NAME="Analytics"
# Loopback port used by the API container and Caddy's reverse_proxy upstream.
API_PORT="3000"

# Raw events older than this are compacted into daily aggregate rows.
RETENTION_DAYS="90"
